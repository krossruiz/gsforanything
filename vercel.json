{
  "version": 2,
  "builds": [
    {
      "src": "site-source/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "site-source/index.html",
          "site-source/main.js",
          "site-source/p5Import.js",
          "site-source/syntaxHighlight.js",
          "site-source/version.js",
          "site-source/versions.json",
          "site-source/htmlInCanvas.js",
          "site-source/menuSystem.js",
          "site-source/exporter.js",
          "site-source/creationContext.js",
          "site-source/communityMerge.js",
          "site-source/twinSticks.js",
          "site-source/cameraControls.js",
          "site-source/chatPrompt.js",
          "site-source/threejsAddons/**",
          "site-source/vendor_modules/**"
        ],
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "site-source/server.js"
    }
  ]
}
